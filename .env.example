# TrustChain Environment Variables
# Copy this file to .env and fill in the values

# Soroban Contract IDs (Stellar Testnet)
VITE_CREDENTIAL_CONTRACT_ID=
VITE_REPUTATION_CONTRACT_ID=

# Sponsor secret key for gasless (fee-bumped) transactions
# Generate a new keypair at https://laboratory.stellar.org/#account-creator?network=test
VITE_SPONSOR_SECRET=
