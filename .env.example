# TrustChain Environment Variables
# Copy this file to .env and fill in the values

# Soroban Contract IDs (Stellar Testnet)
VITE_CREDENTIAL_CONTRACT_ID=
VITE_REPUTATION_CONTRACT_ID=

# Sponsor PUBLIC key for the indexer (safe for client bundle)
# Derive from your sponsor secret: node -e "const{Keypair}=require('@stellar/stellar-sdk');console.log(Keypair.fromSecret('YOUR_SECRET').publicKey())"
VITE_SPONSOR_PUBLIC_KEY=

# ⚠️  SPONSOR_SECRET — server-side only!
# Set this in Vercel Dashboard → Settings → Environment Variables
# NEVER prefix with VITE_ — that embeds it in the client JS bundle.
# SPONSOR_SECRET=
